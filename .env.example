# --- Database (Neon) -------------------------------------------------------
# Pooled connection string - used by the app at runtime (Vercel / local dev).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/job_assist?sslmode=require"
# Direct (unpooled) connection string - used by Prisma Migrate / Studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/job_assist?sslmode=require"

# --- Single-user authentication -------------------------------------------
# The only account that can log in.
ADMIN_EMAIL="you@example.com"
# Generate with: npm run generate-password-hash
# IMPORTANT: inside .env files the dollar signs must stay escaped. Next.js expands $VAR
# in these files, so an unescaped hash arrives truncated and every login fails.
# The generator prints a ready-to-paste line that looks like this:
ADMIN_PASSWORD_HASH="\$2b\$12\$....................................................."
# Random 32+ char secret used to sign the session cookie:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# AUTH_SECRET is hex, so it needs no escaping.
AUTH_SECRET="replace-me-with-a-long-random-string"
