# --- Database (Neon) -------------------------------------------------------
# Pooled connection string - used by the app at runtime (Vercel / local dev).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/job_assist?sslmode=require"
# Direct (unpooled) connection string - used by Prisma Migrate / Studio.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/job_assist?sslmode=require"

# --- Single-user authentication -------------------------------------------
# The only account that can log in. Both values are read server-side only.
ADMIN_EMAIL="you@example.com"
# Choose a long, private password. Note: in .env files Next.js expands `$VAR`, so avoid
# a `$` here (or you will wonder why the password no longer matches).
ADMIN_PASSWORD="choose-a-long-private-password"
# Random 32+ char secret used to sign the session cookie:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string"
